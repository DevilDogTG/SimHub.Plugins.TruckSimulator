<Project>
  <!-- Shared settings for every project. The plugin runtime is net48 (see docs/adr/ADR-0001). -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>

    <Company>DevDogs</Company>
    <Authors>DevDogs</Authors>
    <Product>DevDogs.TruckSimulator</Product>
    <Copyright>Copyright (c) 2026 DevDogs</Copyright>
    <Version>0.1.0-dev.5</Version>
  </PropertyGroup>

  <!--
    SimHub install folder, used to reference SimHub's own assemblies (never committed or copied).
    Override with: dotnet build -p:SimHubPath="D:\SimHub"
  -->
  <PropertyGroup>
    <SimHubPath Condition="'$(SimHubPath)' == '' and '$(OS)' == 'Windows_NT'">$([MSBuild]::GetRegistryValue('HKEY_CURRENT_USER\Software\SimHub', 'InstallDirectory'))</SimHubPath>
    <SimHubPath Condition="'$(SimHubPath)' == ''">C:\Program Files (x86)\SimHub</SimHubPath>
  </PropertyGroup>
</Project>
