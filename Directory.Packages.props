<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Polyfills so modern C# features (init, records, required, ...) compile for net48/netstandard2.0. -->
    <PackageVersion Include="PolySharp" Version="1.16.0" />

    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- Held on 7.x: 8.x moved to a commercial license (Xceed); 7.x is Apache-2.0. -->
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
  </ItemGroup>
</Project>
