<Project Sdk="Microsoft.NET.Sdk">
  <!-- Game-agnostic logic with no SimHub dependency, so it is testable on any runtime. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>DevDogs.TruckSimulator.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provided at runtime by SimHub (see Directory.Packages.props); not copied to the output. -->
    <PackageReference Include="Newtonsoft.Json" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Speed-camera databases, one folder per game (docs/adr/ADR-0004). -->
    <EmbeddedResource Include="Radar\Data\**\camera_db.csv;Radar\Data\**\camera_db.meta.json"
                      LogicalName="DevDogs.TruckSimulator.Radar/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DevDogs.TruckSimulator.Core.Tests" />
  </ItemGroup>
</Project>
