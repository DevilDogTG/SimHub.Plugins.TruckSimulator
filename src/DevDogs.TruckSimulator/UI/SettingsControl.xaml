<UserControl x:Class="DevDogs.TruckSimulator.UI.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Text="DEVDOGS TRUCK SIMULATOR" FontSize="16" FontWeight="Bold" />
      <TextBlock x:Name="VersionText" Margin="0,4,0,0" Opacity="0.7" />
    </StackPanel>

    <TabControl x:Name="Tabs">
      <!-- Settings -->
      <TabItem Header="Settings">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12" MaxWidth="640" HorizontalAlignment="Left">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="50" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="40" />
                <RowDefinition Height="40" />
                <RowDefinition Height="48" />
                <RowDefinition Height="40" />
                <RowDefinition Height="40" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Over speed margin (mph)"
                         ToolTip="Speed above the limit at which Job.OverSpeedLimit turns on. Negative values warn below the limit." />
              <Slider Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Minimum="-10" Maximum="10"
                      IsSnapToTickEnabled="True" TickFrequency="1"
                      Value="{Binding Settings.OverSpeedMargin, Mode=TwoWay}" />
              <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                         Text="{Binding Settings.OverSpeedMargin}" />

              <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Wear warning level (%)"
                         ToolTip="Average wear above which Damage.WearWarning turns on." />
              <Slider Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="100"
                      IsSnapToTickEnabled="True" TickFrequency="1"
                      Value="{Binding Settings.WearWarningLevel, Mode=TwoWay}" />
              <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                         Text="{Binding Settings.WearWarningLevel}" />

              <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Display dash units in metric" />
              <CheckBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"
                        IsChecked="{Binding Settings.DashUnitMetric, Mode=TwoWay}" />

              <TextBlock Grid.Row="3" Grid.ColumnSpan="3" VerticalAlignment="Bottom" Margin="0,0,0,6"
                         Text="SPEED-CAMERA RADAR (ETS2)" FontWeight="Bold" />

              <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Alert distance (m)"
                         ToolTip="How far ahead a speed camera starts Radar.CameraAhead. The alert holds for 50 m more." />
              <Slider Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Minimum="100" Maximum="1000"
                      IsSnapToTickEnabled="True" TickFrequency="10"
                      Value="{Binding Settings.RadarAlertDistance, Mode=TwoWay}" />
              <TextBlock Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                         Text="{Binding Settings.RadarAlertDistance}" />

              <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="Cone angle (degrees)"
                         ToolTip="How far to either side of the travel direction a camera still counts as ahead. Wider catches bends but also parallel roads." />
              <Slider Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" Minimum="5" Maximum="60"
                      IsSnapToTickEnabled="True" TickFrequency="1"
                      Value="{Binding Settings.RadarConeAngle, Mode=TwoWay}" />
              <TextBlock Grid.Row="5" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                         Text="{Binding Settings.RadarConeAngle}" />
            </Grid>

            <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Opacity="0.7"
                       Text="City and country translations are not included in this development build; localisation properties show the names the game reports." />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Live telemetry -->
      <TabItem x:Name="LiveTab" Header="Live telemetry">
        <DockPanel Margin="12">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8"
                       Text="Shows only what this plugin read from the game and what it published, to tell its values apart from SimHub's own. Display only; off by default and only refreshed while this tab is open." />
            <StackPanel Orientation="Horizontal">
              <CheckBox x:Name="LiveSwitch" VerticalAlignment="Center" Content="Show live values"
                        Checked="LiveSwitch_Changed" Unchecked="LiveSwitch_Changed" />
              <TextBlock Text="Filter" VerticalAlignment="Center" Margin="24,0,8,0" />
              <TextBox x:Name="FilterBox" Width="240" VerticalAlignment="Center" TextChanged="FilterBox_TextChanged" />
            </StackPanel>
            <TextBlock x:Name="LiveStatusText" Margin="0,8,0,8" TextWrapping="Wrap" />
          </StackPanel>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="2*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="READ FROM THE GAME" FontWeight="Bold" Margin="0,0,0,4" />
            <DataGrid x:Name="InputsGrid" Grid.Row="1" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Field" Binding="{Binding Name}" Width="Auto" />
                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="Auto" />
                <DataGridTextColumn Header="SimHub source" Binding="{Binding Source}" Width="*" />
              </DataGrid.Columns>
              <DataGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Copy SimHub source" Click="CopyInputSource_Click" />
                </ContextMenu>
              </DataGrid.ContextMenu>
            </DataGrid>

            <TextBlock Grid.Row="0" Grid.Column="2" Text="PUBLISHED BY THIS PLUGIN" FontWeight="Bold" Margin="0,0,0,4" />
            <DataGrid x:Name="OutputsGrid" Grid.Row="1" Grid.Column="2" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Property" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="Auto" />
              </DataGrid.Columns>
              <DataGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Copy property name" Click="CopyOutputName_Click" />
                </ContextMenu>
              </DataGrid.ContextMenu>
            </DataGrid>

            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Text="RECENT EVENTS (NEWEST FIRST)" FontWeight="Bold" Margin="0,12,0,4" />
            <ListBox x:Name="EventsList" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" FontFamily="Consolas" />
          </Grid>
        </DockPanel>
      </TabItem>

      <!-- Recording -->
      <TabItem Header="Recording">
        <StackPanel Margin="12" MaxWidth="640" HorizontalAlignment="Left">
          <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8"
                     Text="Records the game values this plugin reads, while ETS2 or ATS is running, to replay real drives in tests. About 15 MB per hour. Also available as the ToggleTelemetryRecording action." />
          <StackPanel Orientation="Horizontal">
            <Button x:Name="RecordButton" MinWidth="140" Padding="12,4" Click="RecordButton_Click" />
            <Button MinWidth="140" Padding="12,4" Margin="8,0,0,0" Content="Open recordings folder" Click="OpenFolderButton_Click" />
          </StackPanel>
          <TextBlock x:Name="RecordingStatus" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
