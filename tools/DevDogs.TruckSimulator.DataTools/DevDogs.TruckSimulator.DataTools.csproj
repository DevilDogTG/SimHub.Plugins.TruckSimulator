<Project Sdk="Microsoft.NET.Sdk">
  <!-- Maintainer tool: generates the plugin's game data (camera database) from an extracted game. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DevDogs.TruckSimulator.DataTools</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DevDogs.TruckSimulator.Core.Tests" />
  </ItemGroup>
</Project>
